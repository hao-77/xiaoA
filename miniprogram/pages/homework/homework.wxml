<navigation-bar title="详情页面" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>
<!-- 动态展示考核时间，兼容字段为空的情况 -->
<view class="container" style="height: 1410rpx; display: flex; box-sizing: border-box"><view class="duration" style="position: relative; left: 0rpx; top: -152rpx">
<view>
  一期作业
</view>  {{currentProcess.startTime}} —— {{currentProcess.endTime}}
</view>
<view class="request">
  <view class="requestTitle">考核要求</view>
  <view class="requestDetailed"></view>
</view>
<view class="submit">
  <view class="submitLeft">
    <view class="submitTitle">提交地址</view>
    <view class="submitNumble">1111111@qq.com</view>
  </view>
  <button class="submitbutton" 
          bindtap="copySubmitAddress"
          style="width: 149rpx; display: block; box-sizing: border-box; left: 63rpx; top: 0rpx; position: relative">
    复制
  </button>
</view>
<view class="work">
  作业附件
  <!-- 跳转register页面的按钮，绑定新方法 -->
  <button 
    class="detail-btn" 
    type="primary" 
    bindtap="gotoRegisterPage"
    style="height: 77rpx; width: 459rpx; margin-top: 20rpx; display: block; box-sizing: border-box; position: relative; left: 0rpx; top: 110rpx">
    查看详情
  </button>
</view></view>
