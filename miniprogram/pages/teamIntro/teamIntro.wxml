<!-- 顶部导航栏 -->
<navigation-bar title="团队介绍" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<!-- 轮播图区域（优先用接口返回的轮播图，无则用默认） -->
<swiper class="banner-swiper" indicator-dots circular>
  <!-- 接口返回的轮播图 -->
  <block wx:if="{{teamData.imgUrl1 && teamData.imgUrl1.length > 0}}">
    <swiper-item wx:for="{{teamData.imgUrl1}}" wx:key="index">
      <view class="banner-item">
        <image src="{{item}}" mode="widthFix"></image>
      </view>
    </swiper-item>
  </block>
  <!-- 默认轮播图（接口无数据时显示） -->
  <block wx:else>
    <swiper-item>
      <view class="banner-item">
        <image src="/images/team-banner1.png" mode="widthFix"></image>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="banner-item">
        <image src="/images/team-banner2.png" mode="widthFix"></image>
      </view>
    </swiper-item>
  </block>
</swiper>

<!-- 选项卡区域 -->
<view class="tab-group">
  <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
    <image src="/images/team-icon.png" mode="widthFix"></image>
    <text>团队风采</text>
  </view>
  <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
    <image src="/images/group-icon.png" mode="widthFix"></image>
    <text>组别介绍</text>
  </view>
</view>

<!-- 内容区域（根据选项卡切换展示不同内容 + 可编辑） -->
<view class="content-area">
  <!-- 团队风采标题/内容 -->
  <view wx:if="{{currentTab === 0}}">
    <view class="content-title">{{teamData.teamTitle || '团队风采'}}</view>
    <view class="content-input">
      <textarea 
        placeholder="请输入团队风采介绍" 
        bindinput="onTeamInput"
        value="{{teamData.teamContent || ''}}"></textarea>
    </view>
  </view>
  <!-- 组别介绍标题/内容 -->
  <view wx:elif="{{currentTab === 1}}">
    <view class="content-title">{{teamData.groupTitle || '组别介绍'}}</view>
    <view class="content-input">
      <textarea 
        placeholder="请输入组别介绍内容" 
        bindinput="onGroupInput"
        value="{{teamData.groupContent || ''}}"></textarea>
    </view>
  </view>
</view>

<!-- 底部图片区域（优化内联样式，改为类名） -->
<view class="bottom-img">
  <image src="{{teamData.bottomImg || '/images/team-bottom.png'}}" mode="widthFix"></image>
</view>

<!-- 保存按钮（可选，用于提交编辑后的内容） -->
<button class="save-btn" bindtap="saveTeamData" wx:if="{{isSuperAdmin}}">保存修改</button>

<custom-tabbar currentPage="home"></custom-tabbar>