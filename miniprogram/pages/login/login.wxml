<navigation-bar title="登录" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>
<view class="login-container" style="height: 966rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">

  <!-- 登录/注册卡片 -->
  <view class="login-card" style="height: 457rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">
    <view class="avatar" style="position: relative; left: 253rpx; top: 82rpx; width: 182rpx; height: 184rpx; display: block; box-sizing: border-box">
      <image src="../../assets/touxiang2.png" alt=""/>

    </view>
    
    <!-- 提示文本 -->
    <view class="login-tip" style="position: relative; left: -2rpx; top: 140rpx; text-align: center; color: #666; font-size: 28rpx">
      选择以下方式完成登录
    </view>

    <!-- 手机号输入框 -->
    <view style="position: relative; left: 30rpx; top: 215rpx; width: 630rpx; height: 80rpx; border: 1px solid #eee; border-radius: 40rpx; padding: 0 30rpx; box-sizing: border-box">
      <input 
        type="number" 
        placeholder="请输入手机号" 
        bindinput="onPhoneInput"
        style="width: 100%; height: 100%; font-size: 28rpx; line-height: 80rpx;"
      />
    </view>

    <!-- 密码输入框 -->
    <view style="position: relative; left: 30rpx; top: 227rpx; width: 630rpx; height: 80rpx; border: 1px solid #eee; border-radius: 40rpx; padding: 0 30rpx; box-sizing: border-box; margin-top: 20rpx">
      <input 
        type="password" 
        placeholder="请输入密码" 
        bindinput="onPasswordInput"
        style="width: 100%; height: 100%; font-size: 28rpx; line-height: 80rpx;"
      />
    </view>
  </view>

  <!-- 账号密码登录按钮 -->
  <button 
    bindtap="onAccountLogin" 
    loading="{{accountLoadingBtn}}"
    disabled="{{accountLoadingBtn || wechatLoadingBtn}}"
    style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 300rpx; position: relative; width: 630rpx; border-radius: 40rpx; background: #ff7a45; color: #fff; font-size: 30rpx"
  >
    {{accountLoadingBtn ? '登录中...' : '账号密码登录'}}
  </button>

  <!-- 微信一键登录按钮 -->
  <button 
    bindtap="onWechatLogin" 
    loading="{{wechatLoadingBtn}}"
    disabled="{{wechatLoadingBtn || accountLoadingBtn}}"
    style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 330rpx; position: relative; width: 630rpx; border-radius: 40rpx; background: #09bb07; color: #fff; font-size: 30rpx; margin-top: 20rpx"
  >
    {{wechatLoadingBtn ? '登录中...' : '微信一键登录'}}
  </button>

  <!-- 加载中弹窗 -->
  <view class="loading-modal" wx:if="{{loading && !accountLoadingBtn && !wechatLoadingBtn}}">
    <view class="loading-content">
      <image class="loading-icon" src="/images/loading.gif"></image>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
</view>