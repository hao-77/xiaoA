<navigation-bar title="报名详情" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>
<view class="login-container" style="height: 966rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">

  <!-- 登录/注册卡片 -->
  <view class="login-card">
    <view class="avatar" style="position: relative; left: 282rpx; top: 85rpx; width: 129rpx; height: 129rpx; display: block; box-sizing: border-box">
      <image src="../../assets/默认头像.png" alt=""/>
    </view>
    <!-- 表单区域 -->
    <view class="form-section" style="position: relative; left: 0rpx; top: 164rpx">
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">姓名</text>
          <text class="label-required">*</text>
        </view>
        <input 
          class="form-input" 
          placeholder="请输入真实姓名" 
          placeholder-class="placeholder"
          type="text"
          value="{{realName}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="label-text">手机号</text>
          <text class="label-required">*</text>
        </view>
        <input 
          class="form-input" 
          placeholder="请输入手机号" 
          placeholder-class="placeholder"
          type="number"
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>
    </view>
  </view>

  <!-- 登录按钮绑定点击事件 -->
  <button 
    bindtap="onLogin" 
    disabled="{{!canLogin}}"
    style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 272rpx; position: relative"
  >
    登录/注册
  </button>

  <!-- 加载中弹窗 -->
  <view class="loading-modal" wx:if="{{loading}}">
    <view class="loading-content">
      <image class="loading-icon" src="/images/loading.gif"></image>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
</view>