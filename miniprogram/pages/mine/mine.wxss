/* pages/mine/mine.wxss */

/* 页面背景 */
page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-attachment: fixed;
}

/* 背景装饰 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #fff;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #fff;
  bottom: 100rpx;
  left: -80rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: #fff;
  bottom: -50rpx;
  right: 100rpx;
}

/* 个人信息卡片 */
.profile-card {
  position: relative;
  z-index: 1;
  margin: 40rpx 30rpx;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10px);
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.avatar-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.avatar-edit-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.avatar-edit-icon .icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 名字区域 */
.name-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.name-display {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #f5f7fa, #ffffff);
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.edit-icon {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #667eea;
}

/* 编辑名字 */
.name-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.name-input {
  width: 80%;
  height: 80rpx;
  padding: 0 30rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  font-size: 32rpx;
  text-align: center;
  border: 2rpx solid #667eea;
}

.edit-buttons {
  display: flex;
  margin-top: 20rpx;
}

.btn-cancel,
.btn-confirm {
  padding: 12rpx 40rpx;
  margin: 0 15rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.btn-cancel {
  color: #999;
  background: #f5f7fa;
}

.btn-confirm {
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

/* 手机号区域 */
.phone-section {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.phone-label {
  font-size: 26rpx;
  color: #999;
}

.phone-value {
  font-size: 26rpx;
  color: #666;
}

/* 信息标签 */
.info-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.tag {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #667eea20, #764ba220);
  border-radius: 30rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.tag-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #667eea;
}

/* 按钮区域 */
.action-buttons {
  margin: 40rpx 30rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  margin-bottom: 20rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.95);
  color: #ff6b6b;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.btn-text {
  font-weight: 500;
}

/* 未登录状态卡片 */
.not-login-card {
  position: relative;
  z-index: 1;
  margin: 100rpx 30rpx;
  padding: 80rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.not-login-avatar {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.not-login-avatar .avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  opacity: 0.6;
}

.not-login-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.sub-text {
  font-size: 26rpx;
  color: #999;
}

.login-btn {
  width: 60%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
}

/* 提示信息 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 24rpx 48rpx;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  z-index: 9999;
  transition: opacity 0.3s;
  pointer-events: none;
}
