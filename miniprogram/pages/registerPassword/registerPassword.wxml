<navigation-bar title="注册" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>
<view class="register-container" style="height: 966rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">

  <!-- 注册/注册卡片 -->
  <view class="register-card" style="height: 600rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">
    <view class="avatar" style="position: relative; left: 253rpx; top: 40rpx; width: 182rpx; height: 184rpx; display: block; box-sizing: border-box">
      <image src="../../assets/touxiang2.png" alt=""/>
    </view>

    <!-- 提示文本 -->
    <view class="register-tip" style="position: relative; left: -2rpx; top: 80rpx; text-align: center; color: #666; font-size: 28rpx">
      请设置您的登录密码
    </view>

    <!-- 谨记密码提示 -->
    <view class="password-tip" style="position: relative; left: 0rpx; top: 100rpx; text-align: center; color: #ff6b6b; font-size: 24rpx; padding: 0 40rpx">
      ⚠️ 请谨记密码，丢失后找回非常繁琐！
    </view>

    <!-- 手机号输入框 -->
    <view style="position: relative; left: 30rpx; top: 140rpx; width: 630rpx; height: 80rpx; border: 1px solid #eee; border-radius: 40rpx; padding: 0 30rpx; box-sizing: border-box">
      <input
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        style="width: 100%; height: 100%; font-size: 28rpx; line-height: 80rpx;"
      />
    </view>

    <!-- 密码输入框 -->
    <view style="position: relative; left: 30rpx; top: 155rpx; width: 630rpx; height: 80rpx; border: 1px solid #eee; border-radius: 40rpx; padding: 0 30rpx; box-sizing: border-box; margin-top: 20rpx">
      <input
        type="password"
        placeholder="请输入密码（至少6位）"
        bindinput="onPasswordInput"
        style="width: 100%; height: 100%; font-size: 28rpx; line-height: 80rpx;"
      />
    </view>

    <!-- 确认密码输入框 -->
    <view style="position: relative; left: 30rpx; top: 170rpx; width: 630rpx; height: 80rpx; border: 1px solid #eee; border-radius: 40rpx; padding: 0 30rpx; box-sizing: border-box; margin-top: 20rpx">
      <input
        type="password"
        placeholder="请再次输入密码"
        bindinput="onConfirmPasswordInput"
        style="width: 100%; height: 100%; font-size: 28rpx; line-height: 80rpx;"
      />
    </view>
  </view>

  <!-- 注册按钮 -->
  <button
    bindtap="onRegister"
    loading="{{loading}}"
    disabled="{{loading}}"
    style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 300rpx; position: relative; width: 630rpx; border-radius: 40rpx; background: #ff7a45; color: #fff; font-size: 30rpx"
  >
    {{loading ? loadingText : '立即注册'}}
  </button>

  <!-- 返回登录按钮 -->
  <button
    bindtap="goToLogin"
    style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 330rpx; position: relative; width: 630rpx; border-radius: 40rpx; background: #fff; color: #666; font-size: 30rpx; margin-top: 20rpx; border: 1px solid #ddd"
  >
    已有账号，返回登录
  </button>

  <!-- 加载中弹窗 -->
  <view class="loading-modal" wx:if="{{loading}}">
    <view class="loading-content">
      <image class="loading-icon" src="/images/loading.gif"></image>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
</view>
