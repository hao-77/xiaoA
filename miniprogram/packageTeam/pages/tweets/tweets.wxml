<!-- packageTeam/pages/tweets/tweets.wxml -->
<navigation-bar title="精选推文" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<view class="tweets-container">
  <!-- 推文列表 -->
  <view class="tweet-list" wx:if="{{tweetList.length > 0}}">
    <block wx:for="{{tweetList}}" wx:key="id">
      <view class="tweet-card" bindtap="onTweetClick" data-index="{{index}}">
        <!-- 推文头部 -->
        <view class="tweet-header">
          <image class="tweet-avatar" src="{{item.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="tweet-info">
            <view class="tweet-author">{{item.author || '匿名用户'}}</view>
            <view class="tweet-time">{{item.createTime || ''}}</view>
          </view>
        </view>
        
        <!-- 推文内容 -->
        <view class="tweet-content">
          <text>{{item.content}}</text>
        </view>
        
        <!-- 推文图片（如果有） -->
        <view class="tweet-images" wx:if="{{item.images && item.images.length > 0}}">
          <image 
            wx:for="{{item.images}}" 
            wx:for-item="img" 
            wx:key="index" 
            src="{{img}}" 
            mode="aspectFill" 
            class="tweet-img"
          ></image>
        </view>
        
        <!-- 推文底部 -->
        <view class="tweet-footer">
          <view class="tweet-stats">
            <view class="stat-item">
              <text class="stat-icon">👍</text>
              <text class="stat-count">{{item.likeCount || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">💬</text>
              <text class="stat-count">{{item.commentCount || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">🔄</text>
              <text class="stat-count">{{item.shareCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/assets/empty.png" mode="aspectFit"></image>
    <text class="empty-text">暂无推文</text>
  </view>
  
  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{tweetList.length > 0}}">
    <text wx:if="{{loading && !refreshing}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>
</view>
