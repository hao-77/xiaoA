<!-- 顶部导航栏 -->
<navigation-bar title="团队介绍" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<!-- 顶部封面图（Swiper轮播图样式） -->
<swiper class="banner-swiper" indicator-dots="{{false}}" circular="{{false}}">
  <swiper-item>
    <view class="banner-item">
      <image src="../../assets/teamHeader.jpg" mode="aspectFill"></image>
    </view>
  </swiper-item>
</swiper>

<!-- 内容卡片区域 -->
<view class="content-wrapper">
  <!-- 快捷入口卡片 - 放在最前面更显眼 -->
  <view class="menu-card">
    <view class="menu-item clickable" bindtap="toProjectIntro">
      <view class="menu-left">
        <view class="menu-icon">📋</view>
        <view class="menu-text">项目介绍</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item clickable" bindtap="toGroupIntro">
      <view class="menu-left">
        <view class="menu-icon">👥</view>
        <view class="menu-text">组别介绍</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 团队介绍卡片 -->
  <view class="intro-card">
    <view class="card-header">
      <view class="card-icon">🏆</view>
      <view class="card-title">团队介绍</view>
    </view>
    <view class="card-body">
      <view class="intro-text">
        小A创新创业团队成立于2015年，涵盖机械制造、自动化、软件开发、AI等领域，于2019年入驻国家级创新创业教育实践基地—工大创谷，成为主要运营团队。
      </view>
      <view class="intro-stats">
        <view class="stat-item">
          <view class="stat-number">100+</view>
          <view class="stat-label">软著专利</view>
        </view>
        <view class="stat-item">
          <view class="stat-number">300万</view>
          <view class="stat-label">企业合作资金</view>
        </view>
        <view class="stat-item">
          <view class="stat-number">11+篇</view>
          <view class="stat-label">论文</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 合作伙伴卡片 -->
  <view class="partner-card">
    <view class="card-header">
      <view class="card-icon">🤝</view>
      <view class="card-title">合作伙伴</view>
    </view>
    <view class="card-body">
      <view class="partner-text">
        团队与华为共建鲲鹏&昇腾开发者创享社，持续为鲲鹏昇腾及华为各产业链输送高质量实战型人才和拔尖创新人才。
      </view>
    </view>
  </view>

  <!-- 团队荣誉卡片 -->
  <view class="honor-card">
    <view class="card-header">
      <view class="card-icon">🌟</view>
      <view class="card-title">团队荣誉</view>
    </view>
    <view class="card-body">
      <view class="honor-list">
        <view class="honor-item">
          <view class="honor-badge">逾百位</view>
          <view class="honor-desc">师兄师姐 保研就业创业</view>
        </view>
        <view class="honor-item">
          <view class="honor-badge">国、省级奖项</view>
          <view class="honor-desc">累计300+项</view>
        </view>
        <view class="honor-item">
          <view class="honor-badge">交流机会</view>
          <view class="honor-desc">国内外40+次</view>
        </view>
      </view>
    </view>
  </view>
</view>
