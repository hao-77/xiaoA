<!-- 顶部导航栏 -->
<navigation-bar title="团队介绍" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<!-- 轮播图区域（单张图，去掉指示器） -->
<swiper class="banner-swiper" indicator-dots="{{false}}" circular="{{false}}">
  <swiper-item>
    <view class="banner-item">
      <image src="../assets/tu2.png" mode="aspectFill"></image>
    </view>
  </swiper-item>
</swiper>

<!-- 内容卡片区域（层叠式） -->
<view class="card-stack">
  <!-- 底层卡片 -->
  <view class="content-card layer-back"></view>
  <!-- 中间层卡片 -->
  <view class="content-card layer-middle"></view>
  <!-- 顶层卡片（内容） -->
  <view class="content-card layer-front">
    <!-- 团队介绍 -->
    <view class="section-item0">
      <view class="section-title">团队介绍</view>
      <view class="section-content">
        小A创新创业团队成立于2015年，涵盖机械制造、自动化、软件开发、AI等领域，于2019年入驻国家级创新创业教育实践基地—工大创谷，成为主要运营团队。团队与华为共建鲲鹏&昇腾开发者创享社，持续为鲲鹏昇腾及华为各产业链输送高质量实战型人才和拔尖创新人才。团队摘得国赛金奖等国家级以上奖项、省级奖项累计200+奖项、企业合作累计资金达300万元、发表SCI、EI论文11篇专利软著累计百余项、国内外交流机会超过30次、每年在项目上的流动资金至少20w+，成为工大创谷高水平创新创业团队。
      </view>
    </view>

    <!-- 项目介绍 -->
    <view class="section-item clickable" bindtap="toProjectIntro">
      <view class="section-title">项目介绍</view>
      <view class="section-arrow">点击查看 →</view>
    </view>

    <!-- 组别介绍（绑定跳转到groupIntro页面的方法） -->
    <view class="section-item clickable" bindtap="toGroupIntro">
      <view class="section-title">组别介绍</view>
      <view class="section-arrow">点击查看 →</view>
    </view>
  </view>
</view>