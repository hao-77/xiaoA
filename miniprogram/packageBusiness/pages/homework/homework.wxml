<navigation-bar title="报名详情" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<view class="container">
  <!-- 顶部：报名成功提示 - 全新设计 -->
  <view class="success-card">
    <view class="success-icon-wrap">
      <view class="success-circle">
        <text class="check-icon">✓</text>
      </view>
    </view>
    <view class="success-title">报名成功</view>
    <view class="success-subtitle">感谢您的加入，期待您的精彩表现</view>
  </view>

  <!-- 中间：报名组别信息 - 卡片式设计 -->
  <view class="info-card" wx:if="{{userSignUpInfo}}">
    <view class="card-header">
      <view class="card-icon">📋</view>
      <view class="card-title">我的报名信息</view>
    </view>
    <view class="info-list">
      <view class="info-item">
        <view class="info-label">姓名</view>
        <view class="info-value">{{userSignUpInfo.realName || '-'}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">学号</view>
        <view class="info-value">{{userSignUpInfo.studentId || '-'}}</view>
      </view>
      <view class="info-item highlight">
        <view class="info-label">报名组别</view>
        <view class="info-value group-badge">{{userSignUpInfo.groupName || '-'}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">专业班级</view>
        <view class="info-value">{{userSignUpInfo.majorClass || '-'}}</view>
      </view>
    </view>
  </view>

  <!-- 下面：当前考核进度 - 全新设计 -->
  <view class="progress-card">
    <view class="card-header">
      <view class="card-icon">📊</view>
      <view class="card-title">考核进度</view>
    </view>

    <!-- 进度时间线 -->
    <view class="timeline">
      <view class="timeline-item {{userSignUpInfo ? 'completed' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">提交报名</view>
          <view class="timeline-desc">已完成</view>
        </view>
      </view>
      <view class="timeline-line {{currentProcess.id ? 'active' : ''}}"></view>
      <view class="timeline-item {{currentProcess.id ? 'active' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">等待考核</view>
          <view class="timeline-desc">{{currentProcess.id ? '进行中' : '待开始'}}</view>
        </view>
      </view>
      <view class="timeline-line"></view>
      <view class="timeline-item">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">结果公布</view>
          <view class="timeline-desc">待通知</view>
        </view>
      </view>
    </view>

    <!-- 考核时间 -->
    <view class="duration-section" wx:if="{{currentProcess.id}}">
      <view class="duration-icon">⏰</view>
      <view class="duration-content">
        <view class="duration-label">考核时间</view>
        <view class="duration-time">{{currentProcess.startTime}} — {{currentProcess.endTime}}</view>
      </view>
    </view>
    <view class="duration-section pending" wx:else>
      <view class="duration-icon">📅</view>
      <view class="duration-content">
        <view class="duration-label">考核安排</view>
        <view class="duration-time">暂无考核安排，敬请期待</view>
      </view>
    </view>
  </view>

  <!-- 提交地址信息 -->
  <view class="submit-card">
    <view class="card-header">
      <view class="card-icon">📧</view>
      <view class="card-title">提交作品</view>
    </view>
    <view class="submit-content">
      <view class="submit-address">1111111@qq.com</view>
      <button class="copy-btn" bindtap="copySubmitAddress">
        <text class="copy-icon">📋</text>
        <text>复制</text>
      </button>
    </view>
  </view>

  <!-- 按钮区域 -->
  <view class="button-group">
    <button
      class="primary-btn"
      type="primary"
      bindtap="gotoRegisterPage"
    >
      <text class="btn-icon">📝</text>
      查看考核详情
    </button>
    <button
      class="secondary-btn"
      bindtap="goToHome"
    >
      <text class="btn-icon">🏠</text>
      返回首页
    </button>
  </view>
</view>
