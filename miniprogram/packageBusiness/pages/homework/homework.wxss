/* pages/homework/homework.wxss */
page {
  background-color: #fff3e9;
}

.container {
  padding: 30rpx;
  padding-bottom: 40rpx;
}

/* 成功提示卡片 */
.success-card {
  background: linear-gradient(135deg, #4CAF50, #8BC34A);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  font-size: 48rpx;
  color: #4CAF50;
}

.success-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

/* 通用卡片样式 */
.info-card, .progress-card, .submit-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

/* 报名信息卡片 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  min-width: 500rpx; /* 加宽信息栏宽度 */
}

.info-label {
  font-size: 30rpx;
  color: #666;
  flex: 0 0 160rpx; /* 固定标签宽度，使值区域更宽 */
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex: 1; /* 值区域自动扩展 */
  text-align: right; /* 右对齐使布局更美观 */
}

.group-value {
  color: #ff6b6b;
  font-weight: bold;
}

/* 进度卡片 */
.progress-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
}

.progress-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.progress-number {
  width: 56rpx;
  height: 56rpx;
  background-color: #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.progress-item.active .progress-number {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
}

.progress-label {
  font-size: 24rpx;
  color: #999;
}

.progress-item.active .progress-label {
  color: #ff6b6b;
  font-weight: bold;
}

.progress-line {
  flex: 1;
  height: 4rpx;
  background-color: #ddd;
  margin: 0 10rpx;
  margin-bottom: 40rpx;
}

/* 考核时间 */
.duration-section {
  padding: 20rpx;
  background-color: #fff5f5;
  border-radius: 12rpx;
  border: 1rpx solid #ffdddd;
}

.duration-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.duration-time {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.no-schedule {
  color: #999;
  font-size: 28rpx;
  font-style: italic;
}

/* 提交地址卡片 */
.submit-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.submit-address {
  font-size: 28rpx;
  color: #333;
}

.copy-btn {
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 30rpx;
  margin: 0;
}

/* 按钮区域 */
.button-group {
  margin-top: 40rpx;
}

.detail-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-bottom: 24rpx;
  border: none;
}

.home-btn {
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  color: #666;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 1rpx solid #ddd;
}
