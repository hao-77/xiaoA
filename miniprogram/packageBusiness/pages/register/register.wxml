<navigation-bar title="考核进度" back="{{true}}" color="#000" background="#fff3e9"></navigation-bar>

<!-- 自定义日期下拉选择框（替换原生picker） -->
<view class="registerDate">
  <view class="registerDateLeft">选择日期：</view>
  <view class="registerDateRight">
    <!-- 下拉框触发按钮 -->
    <view class="custom-picker" bindtap="toggleDatePicker" style="height: 81rpx; display: flex; box-sizing: border-box">
      <text class="picker-text">
        {{currentDate}}
      </text>
      <icon type="{{showDatePicker ? 'up' : 'down'}}" size="16" color="#666"></icon>
    </view>
    
    <!-- 下拉日期列表（仅显示可预约日期） -->
    <view class="date-dropdown" wx:if="{{showDatePicker}}">
      <view 
        class="date-item" 
        wx:for="{{formatAvailableDates}}" 
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="selectDate"
        style="{{item.value === currentDate ? 'background:#fff3e9;color:#ff6700;' : ''}}">
        {{item.label}}
      </view>
      <!-- 空状态提示 -->
      <view wx:if="{{formatAvailableDates.length === 0}}" class="date-item empty">
        暂无可用日期
      </view>
    </view>
  </view>
</view>

<!-- 时间段列表 -->
<view class="time-list">
  <block wx:for="{{timeList}}" wx:key="id">
    <view class="time-item {{item.active ? 'active' : ''}} {{item.availablePerson <= 0 ? 'disabled' : ''}}"
          data-index="{{index}}"
          bindtap="onTimeTap">
      <text class="time-text">{{item.time || '未设置时间段'}}</text>
      <text class="count-text">余{{item.availablePerson || 0}}人</text>
    </view>
  </block>
</view>

<!-- 已选信息（修改模式或未预约时显示） -->
<view class="registerInfo" wx:if="{{selectedTime && (!hasAppointed || isModifying)}}">
  <view class="registerTime">已选时间：{{formatDate(currentDate)}} {{selectedTime}}</view>
  <view>剩余名额：{{selectedCount || 0}}人</view>
</view>

<!-- 已预约信息展示（非修改模式时显示） -->
<view class="registerInfo appointed-info" wx:if="{{hasAppointed && !isModifying}}">
  <view class="registerTime">✅ 已报名时间段：</view>
  <view class="appointed-time">
    {{appointmentInfoStartYear}} {{appointmentInfoStart}}-{{appointmentInfoEnd}}
  </view>
</view>

<!-- 按钮区域 -->
<view class="button-container">
  <!-- 未预约且非修改模式：显示预约按钮 -->
  <block wx:if="{{!hasAppointed && !isModifying}}">
    <button class="submit-btn" 
            bindtap="submitAppointment" 
            disabled="{{!selectedTime || selectedCount <= 0}}">
      确认预约
    </button>
  </block>
  
  <!-- 修改模式：显示确认修改和取消修改按钮 -->
  <block wx:if="{{isModifying}}">
    <button class="submit-btn modify-submit-btn" 
            bindtap="submitAppointment" 
            disabled="{{!selectedTime || selectedCount <= 0}}">
      确认修改
    </button>
    <button class="cancel-btn" bindtap="cancelModify">
      取消修改
    </button>
  </block>
  
  <!-- 已预约且非修改模式：显示修改预约按钮 -->
  <block wx:if="{{hasAppointed && !isModifying}}">
    <button class="modify-btn" bindtap="startModifyAppointment">
      修改预约
    </button>
  </block>
</view>

<!-- 自定义报名成功弹窗 -->
<view class="success-modal" wx:if="{{showSuccessModal}}">
  <view class="success-overlay"></view>
  <view class="success-content">
    <!-- 装饰性背景元素 -->
    <image class="success-bg-star1" src="https://raw.githubusercontent.com/lydiastep/alwaysbe-files/main/star1.png" mode="aspectFit"></image>
    <image class="success-bg-star2" src="https://raw.githubusercontent.com/lydiastep/alwaysbe-files/main/star2.png" mode="aspectFit"></image>
    <image class="success-bg-sparkle" src="https://raw.githubusercontent.com/lydiastep/alwaysbe-files/main/sparkle1.png" mode="aspectFit"></image>

    <!-- 主视觉元素 -->
    <view class="success-main-visual">
      <image class="success-dragon" src="https://raw.githubusercontent.com/lydiastep/alwaysbe-files/main/dragon1.png" mode="aspectFit"></image>
      <view class="success-confetti-container">
        <view class="confetti confetti-1"></view>
        <view class="confetti confetti-2"></view>
        <view class="confetti confetti-3"></view>
        <view class="confetti confetti-4"></view>
        <view class="confetti confetti-5"></view>
      </view>
    </view>

    <view class="success-title">
      <text class="title-text">报名成功</text>
      <view class="title-decoration"></view>
    </view>

    <view class="success-desc-container">
      <view class="success-desc">小恐龙已收到你的报名表~</view>
      <view class="success-desc highlight">期待与你的相遇</view>
    </view>

    <view class="success-info">
      <view class="info-item">
        <text class="info-icon">📅</text>
        <text class="info-text">考核时间已通知</text>
      </view>
      <view class="info-item">
        <text class="info-icon">📱</text>
        <text class="info-text">请留意短信通知</text>
      </view>
    </view>

    <button class="success-btn" bindtap="closeSuccessModal">
      <text>收到啦</text>
      <view class="btn-shine"></view>
    </button>

    <!-- 底部装饰 -->
    <view class="success-footer-decoration">
      <view class="footer-line"></view>
      <view class="footer-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>
</view>